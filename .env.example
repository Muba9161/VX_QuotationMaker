# Copy this file to .env for Docker Compose. Replace every placeholder before starting.
# Keep PostgreSQL user, database, and password URL-safe (letters, numbers,
# hyphens, underscores), because Compose builds DATABASE_URL from these values.

# PostgreSQL container initialization. Existing named volumes retain their data and
# credentials; changing these values does not reinitialize an existing database.
POSTGRES_USER=quotation_app
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
POSTGRES_DB=quotation_maker
POSTGRES_PORT=5432

# Local browser URL and host port.
APP_URL=http://localhost:3000
APP_PORT=3000

# Generate separate, random 32-byte secrets for both values.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
OTP_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Optional Google OAuth configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Optional SMTP configuration for invitation and document emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=

# Optional runtime diagnostics / deployment settings.
TRUST_PROXY=false
LOG_LEVEL=info
DEBUG=false

# DATABASE_URL and REDIS_URL are supplied by Compose using the postgres and redis
# service hostnames. LOCAL_STORAGE_PATH is set to /app/storage inside the containers.
