# ==============================================================================
# VORLDX WHITE-LABEL QUOTATION & MOU PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env or files containing real secrets to source control.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example: postgresql://postgres:postgres@localhost:5432/worldx_quotation_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/worldx_quotation_db?schema=public"

# ------------------------------------------------------------------------------
# 2. APPLICATION URL & HOSTING
# ------------------------------------------------------------------------------
# Public base URL of the application (used for document share links, signing URLs, email links)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. LOCAL FILESYSTEM STORAGE
# ------------------------------------------------------------------------------
# Absolute or relative path on server filesystem for storing uploaded logos, letterheads,
# signed artifacts, and generated PDFs (No AWS S3 / object storage per client spec).
LOCAL_STORAGE_PATH="./storage"

# ------------------------------------------------------------------------------
# 4. REDIS CONFIGURATION (Caching, Rate Limiting & Background Job Queues)
# ------------------------------------------------------------------------------
# Reserved for Phase 6 (Background jobs, reminders, and PDF generation workers)
# Example: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 5. SECURITY & SESSION MANAGEMENT
# ------------------------------------------------------------------------------
# Reserved for Phase 1 (Session authentication, JWT signing, password reset tokens)
# Minimum 32-character random string. In production, generate using `openssl rand -hex 32`
JWT_SECRET="replace-with-a-secure-random-32-byte-secret-for-jwt-signing"
SESSION_MAX_AGE_SECONDS=28800

