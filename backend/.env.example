# ==============================================================================
# VorldX White-Label Quotation & MOU Platform - Environment Configuration
# Copy this file to .env and configure values appropriate for your environment.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL Configuration (Persistent Source of Truth)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=vx_quotation_maker
TEST_DATABASE_NAME=vx_quotation_maker_test
DATABASE_USER=postgres
DATABASE_PASSWORD=replace_with_db_password
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Redis Configuration (Short-Lived Caching, Rate Limiting, Queues)
# Set REDIS_ENABLED=true if a Redis instance is available
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=3000

# Local Filesystem Storage (S3 / Cloud Object Storage is strictly prohibited)
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_BYTES=10485760
